---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../content/profile';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = profile.description } = Astro.props;
const pageTitle = title ? `${title} — ${profile.name}` : profile.name;
const canonical = new URL(Astro.url.pathname, Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: 'PhD Student',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'University of Washington' },
  url: Astro.site?.toString(),
  sameAs: profile.links.filter((l) => l.url.startsWith('http')).map((l) => l.url),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Google Analytics (same property as the v2 site) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-S1Z9R2KPMR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-S1Z9R2KPMR');
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="mx-auto w-full max-w-[1100px] flex-1 px-6">
      <slot />
    </main>
    <Footer />
  </body>
</html>
