---
import Image from '../Image';
import qianhuiImage from '../../assets/qianhui.jpg';
import Wrapper from '../../layouts/Wrapper';
import { Caption, Heading, Paragraph } from '../typography';
import { ItemInViewAnimation } from '../InViewAnimation';

export const newsList = [
  {
    title: "✈️ Attending the 26th International Conference on Artificial Intelligence in Education (AIED'25) in Palermo, Italy.",
    date: "07/20/2025 - 07/27/2025",
    isVisible: true
  },
  {
    title: "🎉 Our system demo, 'SlideItRight: Using AI to Find Relevant Slides and Provide Feedback for Open-ended Questions', accepted for the Interactive Event Track at AIED'25!",
    date: "05/27/2025",
    isVisible: true
  },
  {
    title: "🎉 My first first-author paper, 'SlideItRight: Using AI to Find Relevant Slides and Provide Feedback for Open-ended Questions', accepted for the Main Track at AIED'25!",
    date: "04/03/2025",
    isVisible: true
  },
  {
    title: "🎉 Co-authored paper, 'From First Draft to Final Insight: A Multi-agent Approach for Feedback Generation', accepted for the Main Track at AIED'25!",
    date: "04/03/2025",
    isVisible: true
  },
  {
    title: "🎉 Abstract, 'Toward Automated Qualitative Analysis: Leveraging Large Language Models for Tutoring Dialogue Evaluation', accepted for the Workshop “From Data to Discovery: LLMs for Qualitative Analysis in Education” at LAK’25!",
    date: "12/10/2024",
    isVisible: true
  },
  {
    title: "🏅 Officially received the honor of 'Outstanding Graduate of Beijing', marking a perfect end to my undergraduate journey.",
    date: "10/10/2024",
    isVisible: true
  },
  {
    title: "💰 Officially started my master's study at CMU, with a $9000 merit-based scholarship!",
    date: "08/26/2024",
    isVisible: true
  }
]
---

<section id="about" class="w-full flex flex-col lg:grid lg:grid-cols-2 bg-neutral-50">
  <Image
    client:idle
    metadata={qianhuiImage}
    alt="Myself, Qianhui (Chloe), photoed at Apgujyong in Korea"
    className="inset-0 max-h-screen w-full object-cover object-center"
  />
  <Wrapper className="h-full my-20 flex flex-col justify-center lg:my-0">
      <ItemInViewAnimation delay={0.1} client:visible >
        <Caption>
          ABOUT
        </Caption>
        <Heading >
          👋🏻Hi there! I'm Qianhui (Chloe),
        </Heading>
        <Paragraph>
          a first-year HCI graduate student at Carnegie Mellon University, currently based in Pittsburgh, PA, United States.
        </Paragraph>
        <Paragraph>
          My research interest mainly focuses on Human-AI Collaboration, Intelligent User Interface, AI for Education, and User Experience.
        </Paragraph>
      </ItemInViewAnimation>
      <ItemInViewAnimation delay={0.2} client:visible >
        <div class="pl-4 md:pl-8 max-h-[40vh] overflow-y-auto custom-scrollbar mt-4">
          <div class="flex items-center mb-1">
            <div class="text-sm text-slate-500">Recent news</div>
            <span class="text-xs text-slate-400 ml-2">Scroll for more ↓</span>
          </div>
          <ul class="list-disc text-slate-500 text-sm space-y-3 max-w-[60ch] break-words rounded-md border border-slate-200 bg-white/40 p-6">
            {
              newsList.filter(n => n.isVisible).slice(0, 5).map((news) => {
                const parts = news.title.split(/('.*?')/);
                return (
                  <li class="leading-snug">
                    <div class="text-xs text-slate-400 mb-0.5">{news.date}</div>
                    <div>
                      {parts.map((part) =>
                        part.startsWith("'") && part.endsWith("'")
                          ? <i>{part.slice(1, -1)}</i>
                          : part
                      )}
                    </div>
                  </li>
                )
              })
            }
          </ul>
          <details class="mt-2 group">
            <summary class="cursor-pointer text-sm text-slate-400 select-none hover:text-slate-600 transition flex items-center">
              <span>Archived news</span>
              <span class="text-xs text-slate-400 ml-2 hidden group-open:inline-block">Scroll for more ↓</span>
            </summary>
            <ul class="list-disc pl-7 text-slate-400 text-sm space-y-3 mt-1 max-w-[60ch] break-words max-h-48 overflow-y-auto rounded-md border border-slate-200 bg-white/40 p-6 scrollbar-left">
              {
                newsList.filter(n => n.isVisible).slice(5).map((news) => {
                  const parts = news.title.split(/('.*?')/);
                  return (
                    <li class="leading-snug text-left">
                      <div class="text-xs text-slate-400 mb-0.5">{news.date}</div>
                      <div>
                        {parts.map((part) =>
                          part.startsWith("'") && part.endsWith("'")
                            ? <i>{part.slice(1, -1)}</i>
                            : part
                        )}
                      </div>
                    </li>
                  )
                })
              }
            </ul>
          </details>
        </div>
      </ItemInViewAnimation>
  </Wrapper>
</section>

<style>
  .custom-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 #f8fafc;
  }
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
    border-radius: 6px;
    background: #f8fafc;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 6px;
  }
  .scrollbar-left {
    direction: rtl;
  }
  .scrollbar-left > li {
    direction: ltr;
  }
</style>