---
import Wrapper from '../../layouts/Wrapper';
import { Caption, Heading } from '../typography';
---

<section
  id="contact"
  class="relative z-10 w-full bg-gradient-to-b from-slate-900 to-neutral-900"
>
  <Wrapper className='pt-16 pb-4'>
    <div class="flex flex-col items-center text-center">
        <Caption className="mb-4">Contact</Caption>
        <Heading className='mb-8 !text-neutral-50'>Let's get in touch!</Heading>
        <div class="flex flex-col items-center space-y-4">
          <p class="text-neutral-300 text-lg max-w-2xl">
            Always excited to discuss new opportunities, collaborate on interesting projects, or have a coffee chat!
          </p>
        </div>
    </div>
  </Wrapper>
</section>

