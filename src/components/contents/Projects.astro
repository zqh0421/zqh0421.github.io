<section
  id="projects"
  class="relative z-10 w-full"
>
  <Wrapper className='border-b-[0.5px] border-neutral-600 py-28'>
    <ItemInViewAnimation className="flex flex-col items-center text-center" delay={0.1} client:visible >
        <Caption>PROJECTS</Caption>
        <Heading className='text-neutral-50'>I've worked on ...</Heading>
        <Wrapper>
          <ul role="list" class="projectList gap-6 p-0 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
            {
              projectList.map((project, index) => 
                project.isVisible && <Card
                  href={project.href}
                  title={project.title}
                  desc={project.desc}
                  time={project.time}
                  location={project.location}
                  tags={project.tags}
                  cover={project.cover}
                  slug={project.slug}
                  />)
            }
          </ul>
      </Wrapper>
    </ItemInViewAnimation>
  </Wrapper>
</section>