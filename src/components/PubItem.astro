---
import { profile } from '../content/profile';
import type { Publication } from '../lib/types';
import Cat from './Cat.astro';

interface Props {
  pub: Publication;
  showFigure?: boolean;
}

const { pub, showFigure = false } = Astro.props;
const isMe = (name: string) => profile.authorNames.includes(name);
---

<!-- On hover the title turns purple and a paw print appears beside it. -->
<article class="group relative flex flex-wrap gap-5" data-themes={pub.themes.join('|')} data-reveal>
  <Cat
    pose="paw"
    class="absolute top-1 -left-5 size-3.5 -translate-x-1 text-accent/70 opacity-0 transition duration-200 group-hover:translate-x-0 group-hover:opacity-100"
  />
  {showFigure && pub.figure && (
    <img
      src={pub.figure.url}
      alt={pub.figure.alt}
      width="180"
      height="112"
      loading="lazy"
      class="h-28 w-[180px] flex-none rounded object-cover"
    />
  )}
  <div class="min-w-0 flex-[1_1_260px] text-[15px]">
    <h3 class="mb-0.5 text-[17.5px] leading-snug font-bold transition-colors duration-200 group-hover:text-accent">{pub.title}</h3>
    <p class="text-muted">
      {pub.authors.map((name, i) => (
        <>
          {isMe(name) ? <b class="text-ink">{name}</b> : name}
          {i < pub.authors.length - 1 && ', '}
        </>
      ))}
    </p>
    <p class="text-muted">
      <i title={pub.venueFull}>{pub.venue}</i> · {pub.type}
      {pub.note && <> · {pub.note}</>}
      {pub.links.map((link) => <> · <a href={link.url}>{link.label}</a></>)}
    </p>
    <p class="mt-0.5 text-[13px] text-faint">
      <span class="sr-only">Research themes: </span>{pub.themes.join(' / ')}
    </p>
  </div>
</article>
