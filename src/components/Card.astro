---
import Wrapper from '../layouts/Wrapper';
import { ItemInViewAnimation } from './InViewAnimation';
import { Paragraph } from './typography';
export interface Props {
	title: string;
	desc: string;
	href: string;
  time: string;
  location: string;
  tags: string[];
  cover: string;
  slug: string;
}

const { href, title, desc, time, location, tags, cover, slug } = Astro.props;

const isStartWith = (fullStr: string, prefix: string) => {
  if (fullStr.length < prefix.length) return false
  fullStr = fullStr.toUpperCase()
  prefix = prefix.toUpperCase()
  for (let i=0; i<prefix.length; i++) {
    if (fullStr[i] !== prefix[i]) return false
  }
  return true
}
---
<ItemInViewAnimation className="flex flex-col items-center text-center" delay={0.1} client:visible >
  <li class="card list-none flex p-[1px] bg-[color:#23262d] bg-[image:none] bg-[size:400%] bg-[position:100%] rounded-[7px] opacity-100">
    <a href={"project/" + slug} target={isStartWith(href, "http") ? "_blank" : "_self"} class="w-full [text-decoration:none] leading-[1.4] p-4 rounded-lg bg-[#23262d] opacity-80 flex flex-col">
      <img
        src={cover}
        class="aspect-video w-full rounded-[0.25rem] object-cover object-center mb-3"
      />
      <div class="flex flex-col flex-1 p-2">
        <h2 class="m-0 text-sm lg:text-lg font-semibold tracking-wide text-neutral-50 mb-2">
          {title}
          <span>&rarr;</span>
        </h2>
        <Paragraph className="mt-0 mb-2 text-neutral-50 text-xs lg:text-sm line-clamp-2">
          {desc}
        </Paragraph>
        <div class="text-xs text-neutral-400 mb-2">
          {time} • {location}
        </div>
        <ul class="flex flex-wrap gap-1 mt-auto">
          {
            tags.slice(0, 3).map(tag => <li class="tag rounded-full text-center tracking-wide h-5 px-2 py-0.5 text-xs">{tag}</li>)
          }
          {tags.length > 3 && <li class="text-xs text-neutral-400 px-2 py-0.5">+{tags.length - 3}</li>}
        </ul>
      </div>
    </a>
  </li>
</ItemInViewAnimation>
<style>
	.card {
		transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
		transform: translateY(0);
	}
	h2 {
		transition: color 0.4s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.card:is(:hover, :focus-within) {
		background-position: 0;
		background-image: var(--accent-gradient);
		transform: translateY(-4px);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2), 0 8px 25px rgba(0, 0, 0, 0.3);
	}
	.card:is(:hover, :focus-within) h2 {
    color: rgb(var(--accent-light));
	}
  .tag {
    color: rgb(var(--accent-light));
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    background-color: rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
  }
  .card:is(:hover, :focus-within) .tag {
    background-color: rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

