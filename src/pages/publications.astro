---
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import { profile } from '../content/profile';
import { themes } from '../content/themes';
import { getPublications } from '../lib/data';

const pubs = await getPublications();
const years = [...new Set(pubs.map((p) => p.year))];
const filters = [
  { label: 'All', value: '', count: pubs.length },
  ...themes.map((t) => ({ label: t, value: t, count: pubs.filter((p) => p.themes.includes(t)).length })),
].filter((f) => f.count > 0);

// Lists every paper for search engines. https://schema.org/ScholarlyArticle
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Publications by ${profile.name}`,
  about: { '@id': new URL('/#person', Astro.site).toString() },
  hasPart: pubs.map((p) => ({
    '@type': 'ScholarlyArticle',
    headline: p.title,
    author: p.authors.map((name) => ({ '@type': 'Person', name })),
    datePublished: String(p.year),
    ...(p.venueFull && { isPartOf: { '@type': 'PublicationEvent', name: p.venueFull } }),
    keywords: p.themes.join(', '),
    ...(p.links[0] && { url: p.links[0].url }),
    ...(p.links.length > 0 && { sameAs: p.links.map((l) => l.url) }),
  })),
};
---

<Base
  title="Publications"
  description={`Papers by ${profile.name} on ${themes.join(', ').replace(/, ([^,]*)$/, ' and $1')}, at venues including LAK, AIED and AIES.`}
  schema={schema}
>
  <div class="mx-auto max-w-[820px] pt-14">
    <a href="/" class="text-sm font-medium">← Home</a>
    <h1 class="mt-4 mb-3 font-heading text-[44px] leading-[1.1] font-bold">Publications</h1>
    <p class="mb-6 text-muted">
      The most up-to-date list is on <a href={profile.scholarUrl}>Google Scholar</a>.
    </p>

    <!-- Shown by the script below; without JavaScript every paper is listed. -->
    <!-- On phones the filters sit in one row that scrolls sideways instead of wrapping. -->
    <div
      id="theme-filters"
      role="group"
      aria-label="Filter by research theme"
      class="-mx-6 mb-10 hidden gap-x-5 overflow-x-auto px-6 text-[15px] font-bold whitespace-nowrap [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:px-0 sm:whitespace-normal"
    >
      {filters.map((f, i) => (
        <button
          type="button"
          data-theme={f.value}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class="cursor-pointer border-b-2 border-transparent py-1 text-faint transition-colors hover:text-ink aria-pressed:border-cat aria-pressed:text-ink"
        >
          {f.label} · {f.count}
        </button>
      ))}
    </div>

    {years.map((year) => (
      <section class="grid grid-cols-1 gap-y-3 border-t border-line py-6 sm:grid-cols-[80px_minmax(0,1fr)] sm:gap-x-6 sm:gap-y-0" data-year-group>
        <h2 class="font-heading text-[26px] leading-tight font-bold text-accent">{year}</h2>
        <div class="flex flex-col gap-7">
          {pubs.filter((p) => p.year === year).map((pub) => <PubItem pub={pub} />)}
        </div>
      </section>
    ))}
  </div>
</Base>

<script>
  const bar = document.getElementById('theme-filters');
  if (bar) {
    bar.classList.replace('hidden', 'flex');
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('button')];

    bar.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest('button');
      if (!button) return;
      const theme = button.dataset.theme ?? '';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));

      const applyFilter = () => {
        document.querySelectorAll<HTMLElement>('[data-year-group]').forEach((group) => {
          let anyVisible = false;
          group.querySelectorAll<HTMLElement>('article[data-themes]').forEach((article) => {
            const match = !theme || article.dataset.themes!.split('|').includes(theme);
            article.hidden = !match;
            anyVisible ||= match;
          });
          group.hidden = !anyVisible;
        });
      };
      // Cross-fade the list where the browser supports it; otherwise switch instantly.
      if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.startViewTransition(applyFilter);
      } else {
        applyFilter();
      }
    });
  }
</script>
