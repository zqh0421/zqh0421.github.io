---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import NewsList from '../components/NewsList.astro';
import PathSoFar from '../components/PathSoFar.astro';
import { profile } from '../content/profile';
import { getNews, getPublications } from '../lib/data';
import portrait from '../assets/qianhui.jpg';

const featured = (await getPublications()).filter((p) => p.featured);
const news = await getNews();
---

<Base>
  <section class="flex flex-wrap items-center gap-12 pt-[72px] pb-16">
    <Image
      src={portrait}
      alt={`Portrait of ${profile.name}`}
      widths={[260, 520, 780]}
      sizes="260px"
      loading="eager"
      class="h-80 w-[260px] flex-none rounded-2xl object-cover object-[36%_28%]"
    />
    <div class="min-w-0 flex-[1_1_420px]">
      <p class="eyebrow mb-3 text-[13px] text-accent">{profile.motto}</p>
      <h1 class="mb-5 font-serif text-5xl leading-[1.05] tracking-[-0.01em] sm:text-[56px]">
        {profile.headline.start} <em class="text-accent">{profile.headline.emphasis}</em>
      </h1>
      {profile.bio.map((p) => <p class="mb-3.5 max-w-[600px] text-lg text-body">{p}</p>)}
    </div>
  </section>

  <div class="flex flex-wrap gap-14 border-t border-line pt-12">
    <section class="min-w-0 flex-[999_1_560px]" aria-labelledby="pubs-heading">
      <h2 id="pubs-heading" class="section-title mb-6">Publications</h2>
      <div class="flex flex-col gap-7">
        {featured.map((pub) => <PubItem pub={pub} showFigure />)}
      </div>
      <p class="mt-7 text-[15px] font-medium"><a href="/publications/">All publications →</a></p>
    </section>

    <aside class="min-w-0 flex-[1_1_260px]" aria-labelledby="news-heading">
      <h2 id="news-heading" class="section-title mb-6">News</h2>
      <NewsList items={news} />
    </aside>
  </div>

  <section class="mt-20 border-t border-line pt-12" aria-labelledby="path-heading">
    <h2 id="path-heading" class="section-title mb-8">Path so far</h2>
    <PathSoFar />
  </section>
</Base>
